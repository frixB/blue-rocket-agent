# Figma token export (Enterprise plans only, see design-tokens/README.md)
FIGMA_TOKEN=
FIGMA_FILE_KEY=43WfRGUtWOHJa3Q7fAZFj7

# Set to "true" on preview deployments to expose /dev/states
NEXT_PUBLIC_SHOW_STATE_GALLERY=false

# Waitlist signups are POSTed here as JSON { email, source }. Leave empty and
# the waitlist dialog tells people to email instead.
WAITLIST_WEBHOOK_URL=

# Shown on /maintenance (S-21b), e.g. "03:00 UTC". Leave empty for "shortly".
MAINTENANCE_BACK_BY=

# Customer sign-in (Auth.js, architecture.md §9). Leave empty and sign-in
# says it isn't switched on. Then run `npm run db:setup` to create the
# tables and the demo customer (email and password are in scripts/db-setup.mjs).
DATABASE_URL=
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# The site's own URL, e.g. http://localhost:3000 or https://bluerocketagents.com
AUTH_URL=
# Sends the sign-in emails. Without it, local development shows the link on
# screen and production refuses to send.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=Blue Rocket Agents <hello@bluerocketagents.com>
